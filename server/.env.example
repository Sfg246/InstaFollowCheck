# FollowCheck v3 - anonymous public-web mode
# No Instagram username, password, sessionid, API key, or paid provider is used.

ALLOWED_ORIGINS=https://sfg246.github.io
ACCESS_CODE=

# Persistent shared graph/page cache
GRAPH_DB_PATH=/data/followcheck.db
PROFILE_CACHE_TTL_SECONDS=3600
RELATIONSHIP_CACHE_TTL_SECONDS=3600

# Conservative public-web behavior. Requests are serialized and never retried automatically.
PUBLIC_PAGE_SIZE=25
PUBLIC_MIN_REQUEST_INTERVAL_SECONDS=2.0
PUBLIC_COOLDOWN_SECONDS=900
PUBLIC_HTTP_TIMEOUT_SECONDS=15

# Instagram public-web identifiers. Keep configurable because public surfaces can change.
PUBLIC_IG_APP_ID=936619743392459
PUBLIC_FOLLOWERS_QUERY_HASH=c76146de99bb02f6415203be841dd25a
PUBLIC_FOLLOWING_QUERY_HASH=d04b0a864b4b54837c0d870b0e77e076

LOG_LEVEL=INFO
