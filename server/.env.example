# Use a dedicated Instagram account for the collector, not your main account.
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=
# Optional, only if that collector account uses authenticator-app 2FA.
INSTAGRAM_TOTP_SECRET=

# Persistent session file inside the mounted /data volume.
INSTAGRAM_SESSION_FILE=/data/instagram-session.json

# GitHub Pages origin. Add your custom domain too if you use one.
ALLOWED_ORIGINS=https://sfg246.github.io

# Optional friend-only code. Leave blank for no site-level code.
ACCESS_CODE=

# No per-scan credit cap. These values protect the Instagram session itself.
INSTAGRAM_PAGE_SIZE=200
INSTAGRAM_COOLDOWN_SECONDS=900
CACHE_TTL_SECONDS=600

# Optional stable proxy URL if you ever need one. Leave blank normally.
INSTAGRAM_PROXY=
LOG_LEVEL=INFO
